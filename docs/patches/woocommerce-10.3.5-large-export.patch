+		}
+		$state['query_fingerprint'] = $fingerprint;
+		$main['limit']              = min( $limit, max( 1, (int) $main['limit'] ) );
+		$main['return']             = 'objects';
+		$main['paginate']           = false;
+		if ( 'keyset' === $state['mode'] && ( array( 'ID' => 'ASC' ) !== $main['orderby'] || ! empty( $main['offset'] ) ) ) {
+			if ( $state['cursor'] || $state['rows'] ) {
