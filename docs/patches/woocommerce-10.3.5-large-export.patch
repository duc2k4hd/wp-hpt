+	/**
+	 * Read one job.
+	 *
+	 * @param string $id Job ID.
+	 * @return array|null
+	 */
+	public function get( string $id ): ?array {
+		global $wpdb;
+		if ( ! preg_match( '/\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/D', $id ) ) {
