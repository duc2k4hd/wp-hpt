+		if ( $current_cpt !== (bool) $state['cpt'] ) {
+			throw new RuntimeException( 'The product data store changed. Start a new export.' );
+		}
+		$main = array(
+			'status'   => $config['statuses'],
+			'limit'    => $limit,
+			'page'     => $state['page'],
+			'orderby'  => array( 'ID' => 'ASC' ),
+			'return'   => 'objects',
+			'paginate' => false,
