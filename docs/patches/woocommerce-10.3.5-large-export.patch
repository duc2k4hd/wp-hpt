+			}
+		}
+		$selected_ids = null;
+		$preflight    = static function ( $request, $query ) use ( $marker, $args, &$selected_ids ) {
+			$request = \WC_Product_Export_Resources::preflight( $request, $query, $marker, $args['limit'], 'wc_large_export_query' );
