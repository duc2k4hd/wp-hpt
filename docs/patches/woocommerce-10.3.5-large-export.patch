+				if ( $split ) {
+					remove_filter( 'split_the_query', $split, PHP_INT_MAX );
+				}
+			}
+		}
+		if ( ! is_array( $products ) || ( $bounded_cpt && ! $seen ) || count( $products ) > $args['limit'] ) {
