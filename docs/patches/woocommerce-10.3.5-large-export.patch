+							'field'    => 'slug',
+							'terms'    => $args['type'],
+						),
+						array(
+							'taxonomy' => 'product_type',
+							'field'    => 'id',
+							'operator' => 'NOT EXISTS',
+						),
+					);
+					$simplify = static function ( $wp_args, $query_vars ) use ( $marker, $expected ) {
+						if ( ( $query_vars['wc_large_export_query'] ?? null ) === $marker && isset( $wp_args['tax_query'] ) && 'AND' === ( $wp_args['tax_query']['relation'] ?? 'AND' ) ) {
