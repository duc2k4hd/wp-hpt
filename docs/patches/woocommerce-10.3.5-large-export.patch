+			'id'           => $id,
+			'user_id'      => $user,
+			'request_key'  => $request_key,
+			'status'       => 'queued',
+			'config'       => $this->encode( $config ),
+			'checkpoint'   => '{}',
+			'logs'         => $this->encode(
