+/* global jQuery, wc_large_product_export_params */
+/* eslint-disable camelcase */
+;( function ( $ ) {
+	'use strict';
+
+	var $form = $( '#wc-large-export-form' );
+	if ( ! $form.length ) {
+		return;
+	}
+
+	var $tbody = $( '#wc-large-export-jobs tbody' );
